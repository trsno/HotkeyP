<Window x:Class="HotkeyP.App.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False">
    <Border x:Name="Panel" CornerRadius="12" Padding="20,14" MinWidth="220" MaxWidth="640"
            Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0" />
                <TextBlock x:Name="Message" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560" />
            </StackPanel>
            <ProgressBar x:Name="Bar" Height="4" Margin="0,12,0,2" Maximum="1" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
