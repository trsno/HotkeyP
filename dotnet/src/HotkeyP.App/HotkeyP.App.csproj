<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HotkeyP</AssemblyName>
    <RootNamespace>HotkeyP.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HotkeyP.ico</ApplicationIcon>
    <Version>5.0.0</Version>
    <Product>HotkeyP</Product>
    <Copyright>Petr Laštovička and contributors, GNU GPL</Copyright>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and Windows Forms both define Application, MessageBox, ...; only the tray icon uses Windows Forms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\HotkeyP.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotkeyP.Core\HotkeyP.Core.csproj" />
  </ItemGroup>

</Project>
