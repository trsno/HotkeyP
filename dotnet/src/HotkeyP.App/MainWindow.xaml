<Window x:Class="HotkeyP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HotkeyP.App"
        Title="HotkeyP" Width="960" Height="620" MinWidth="640" MinHeight="400"
        Icon="pack://application:,,,/Assets/HotkeyP.ico"
        AllowDrop="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BoolToVisibility x:Key="Visible" />
        <local:BoolToVisibility x:Key="Hidden" Invert="True" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NewCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static local:MainWindow.SearchCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewCommand}" Executed="New_Click" />
        <CommandBinding Command="{x:Static local:MainWindow.SearchCommand}" Executed="Search_Execute" />
    </Window.CommandBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= navigation ================= -->
        <Grid Grid.Column="0" Margin="8,12,4,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,4,0,16">
                <Image Source="pack://application:,,,/Assets/HotkeyP.ico" Width="24" Height="24" Margin="0,0,10,0" />
                <TextBlock Text="HotkeyP" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <ListBox x:Name="Nav" Grid.Row="1" BorderThickness="0" Background="Transparent"
                     SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="Margin" Value="0,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:NavItem">
                        <Grid>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                       Margin="0,6,0,0" Visibility="{Binding IsHeader, Converter={StaticResource Visible}}" />
                            <DockPanel Visibility="{Binding IsHeader, Converter={StaticResource Hidden}}">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" Margin="0,0,12,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AddCategory_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,12,0" />
                        <TextBlock Text="New category" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,12,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= content ================= -->
        <Border Grid.Column="1" Margin="4,8,8,8" CornerRadius="8"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid Margin="20,16,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- title, search, new -->
                <DockPanel>
                    <Button x:Name="NewButton" DockPanel.Dock="Right" Click="New_Click" Margin="8,0,0,0" Padding="14,6"
                            Style="{DynamicResource AccentButtonStyle}" ToolTip="New hotkey (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="New hotkey" />
                        </StackPanel>
                    </Button>
                    <Grid DockPanel.Dock="Right" Width="240">
                        <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" Padding="30,5,8,5" VerticalContentAlignment="Center"
                                 ToolTip="Search by name, program, command or key (Ctrl+F)" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchHint" Text="Search" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ViewTitle" Text="All hotkeys" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>

                <!-- actions on the selected hotkey -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="-10,12,0,8" x:Name="Toolbar">
                    <Button Style="{StaticResource ToolButton}" Click="Edit_Click" ToolTip="Edit (Enter)" x:Name="EditButton">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="Edit" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Run_Click" ToolTip="Run now">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="Run" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Duplicate_Click" ToolTip="Duplicate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="Duplicate" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Delete_Click" ToolTip="Delete (Del)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="Delete" /></StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Button Style="{StaticResource ToolButton}" Click="MoveUp_Click" ToolTip="Move up (Alt+Up)">
                        <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="MoveDown_Click" ToolTip="Move down (Alt+Down)">
                        <TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Category_Click" ToolTip="Move to category" x:Name="CategoryButton">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0" /><TextBlock Text="Category" /></StackPanel>
                    </Button>
                </StackPanel>

                <!-- hotkey list -->
                <ListView x:Name="List" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                          MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown" SelectionChanged="List_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Edit" Click="Edit_Click" InputGestureText="Enter" />
                            <MenuItem Header="Run now" Click="Run_Click" />
                            <MenuItem Header="Duplicate" Click="Duplicate_Click" />
                            <Separator />
                            <MenuItem Header="Move up" Click="MoveUp_Click" InputGestureText="Alt+Up" />
                            <MenuItem Header="Move down" Click="MoveDown_Click" InputGestureText="Alt+Down" />
                            <Separator />
                            <MenuItem Header="Delete" Click="Delete_Click" InputGestureText="Del" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="local:HotkeyRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" Style="{StaticResource Caption}" VerticalAlignment="Center" ToolTip="Number used by multi commands" />
                                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" HorizontalAlignment="Left"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <Image Source="{Binding Icon}" Width="22" Height="22" />
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding Badges}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="6,0,6,1" Margin="0,0,4,0"
                                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ItemsControl Grid.Column="3" ItemsSource="{Binding Keys}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KeyCap}">
                                                <TextBlock Text="{Binding}" Style="{StaticResource KeyCapText}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="3" Text="No shortcut" Style="{StaticResource Caption}" FontStyle="Italic"
                                           VerticalAlignment="Center" Visibility="{Binding HasNoKeys, Converter={StaticResource Visible}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- empty state -->
                <StackPanel Grid.Row="2" x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="EmptyText" Text="No hotkeys yet" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center" />
                    <TextBlock Text="Create one, or drop a program or file here." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- footer -->
                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                    <CheckBox x:Name="EnabledToggle" DockPanel.Dock="Right" Content="Hotkeys enabled" Click="Enabled_Click"
                              ToolTip="Turn all hotkeys off or on" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Margin="-10,0,4,0" Click="FileMenu_Click" ToolTip="Open or save a hotkeys file">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="FileText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
