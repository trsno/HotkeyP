<Window x:Class="HotkeyP.App.HotkeyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkey" Width="620" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,8">
            <StackPanel>
                <TextBlock x:Name="Heading" Text="New hotkey" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

                <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" Padding="8,5" />

                <!-- ============ shortcut ============ -->
                <TextBlock Text="Shortcut" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="TriggerKeyboard" Content="Keyboard" GroupName="Trigger" Margin="0,0,20,0" Checked="Trigger_Changed" />
                            <RadioButton x:Name="TriggerMouse" Content="Mouse buttons" GroupName="Trigger" Margin="0,0,20,0" Checked="Trigger_Changed" />
                            <RadioButton x:Name="TriggerNone" Content="None" GroupName="Trigger" Checked="Trigger_Changed"
                                         ToolTip="Run only from the list, the tray menu, at startup or from a multi command" />
                        </StackPanel>

                        <!-- keyboard -->
                        <StackPanel x:Name="KeyboardPanel">
                            <DockPanel>
                                <Button x:Name="ClearKeyButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,6" Click="ClearKey_Click" ToolTip="Remove the shortcut">
                                    <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="14" />
                                </Button>
                                <Button x:Name="RecordButton" Click="Record_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" MinHeight="42">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="RecordIcon" Text="&#xE765;" Style="{StaticResource Icon}" Margin="0,0,12,0" />
                                        <ItemsControl x:Name="KeyCaps" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="{Binding}" Style="{StaticResource KeyCapText}" /></Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="RecordText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <TextBlock x:Name="ConflictText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- mouse -->
                        <StackPanel x:Name="MousePanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Hold the first buttons, then press the last one. Example: hold Right, click Left." />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="Mouse1" Width="130" SelectionChanged="Mouse_Changed" />
                                <TextBlock Text="+" Margin="8,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="Mouse2" Width="130" SelectionChanged="Mouse_Changed" />
                                <TextBlock Text="+" Margin="8,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="Mouse3" Width="130" SelectionChanged="Mouse_Changed" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="With keys:" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Caption}" />
                                <CheckBox x:Name="MouseCtrl" Content="Ctrl" Margin="0,0,12,0" />
                                <CheckBox x:Name="MouseShift" Content="Shift" Margin="0,0,12,0" />
                                <CheckBox x:Name="MouseAlt" Content="Alt" Margin="0,0,12,0" />
                                <CheckBox x:Name="MouseWin" Content="Win" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ action ============ -->
                <TextBlock Text="Action" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="ActionProgram" Content="Open a program, file or web page" GroupName="Action" Margin="0,0,20,0" Checked="Action_Changed" />
                            <RadioButton x:Name="ActionCommand" Content="Run a command" GroupName="Action" Checked="Action_Changed" />
                        </StackPanel>

                        <!-- program -->
                        <Grid x:Name="ProgramPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Path or URL" VerticalAlignment="Center" />
                            <TextBox x:Name="ExeBox" Grid.Column="1" Padding="8,5" Margin="0,2" />
                            <Button Grid.Column="2" Content="Browse…" Margin="8,2,0,2" Click="BrowseExe_Click" />

                            <TextBlock Grid.Row="1" Text="Arguments" VerticalAlignment="Center" />
                            <TextBox x:Name="ArgsBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="8,5" Margin="0,2" />

                            <TextBlock Grid.Row="2" Text="Start in" VerticalAlignment="Center" />
                            <TextBox x:Name="DirBox" Grid.Row="2" Grid.Column="1" Padding="8,5" Margin="0,2" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Margin="8,2,0,2" Click="BrowseDir_Click" />

                            <TextBlock Grid.Row="3" Text="Window" VerticalAlignment="Center" />
                            <ComboBox x:Name="ShowBox" Grid.Row="3" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,2">
                                <ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="Maximized" />
                                <ComboBoxItem Content="Minimized" />
                            </ComboBox>

                            <TextBlock Grid.Row="4" Text="Priority" VerticalAlignment="Center" />
                            <ComboBox x:Name="PriorityBox" Grid.Row="4" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,2">
                                <ComboBoxItem Content="Idle" />
                                <ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="High" />
                                <ComboBoxItem Content="Realtime" />
                                <ComboBoxItem Content="Below normal" />
                                <ComboBoxItem Content="Above normal" />
                            </ComboBox>

                            <TextBlock Grid.Row="5" Text="Opacity" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                                <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="90" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Opacity_Changed" />
                            </DockPanel>

                            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="AdminBox" Content="Run as administrator" Margin="0,0,20,0" />
                                <CheckBox x:Name="MultiBox" Content="Allow several instances"
                                          ToolTip="Off: if the program is already running, the hotkey switches to it (or minimizes it)" />
                            </StackPanel>
                        </Grid>

                        <!-- command -->
                        <StackPanel x:Name="CommandPanel" Visibility="Collapsed">
                            <Grid>
                                <TextBox x:Name="CommandSearch" Padding="30,5,8,5" TextChanged="CommandSearch_Changed" PreviewKeyDown="CommandSearch_KeyDown" />
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="CommandSearchHint" Text="Search commands" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                            <ListBox x:Name="CommandList" Height="190" Margin="0,6,0,0" SelectionChanged="CommandList_Changed">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="6,8,0,2" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Parameter" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                            <TextBox x:Name="ParamBox" Padding="8,5" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock x:Name="ParamHint" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ options ============ -->
                <TextBlock Text="Options" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Category" VerticalAlignment="Center" />
                        <ComboBox x:Name="CategoryBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,2" />

                        <TextBlock Grid.Row="1" Text="Sound" VerticalAlignment="Center" />
                        <TextBox x:Name="SoundBox" Grid.Row="1" Grid.Column="1" Padding="8,5" Margin="0,2" ToolTip="WAV file played when the hotkey runs" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="8,2,0,2" Click="BrowseSound_Click" />

                        <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <CheckBox x:Name="AskBox" Content="Ask before running" Margin="0,4,20,4" />
                            <CheckBox x:Name="DelayBox" Content="Wait until keys are released" Margin="0,4,20,4" />
                            <CheckBox x:Name="AutoStartBox" Content="Run when HotkeyP starts" Margin="0,4,20,4" />
                            <CheckBox x:Name="TrayBox" Content="Show in tray menu" Margin="0,4,20,4" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource LayerFillColorAltBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,14">
                <Button DockPanel.Dock="Left" Content="Test" Width="90" Click="Test_Click" ToolTip="Run the action now, without saving" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Width="110" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Save_Click" Margin="0,0,8,0" />
                    <Button Content="Cancel" Width="110" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
